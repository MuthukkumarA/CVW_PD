set_retention pgd_retain_spi -domain pd_spi_gated \
 -retention_power_net VDDL_spi_gated \
 -retention_ground_net VSS \
 -elements {
    dut/spi_synth/dut/SckDiv*
    dut/spi_synth/dut/SckMode*
    dut/spi_synth/dut/ChipSelectID*
    dut/spi_synth/dut/ChipSelectDef*
    dut/spi_synth/dut/ChipSelectMode*
    dut/spi_synth/dut/Delay0_reg*
    dut/spi_synth/dut/Delay1_reg*
    dut/spi_synth/dut/Format_reg*
    dut/spi_synth/dut/TransmitData_reg*
    dut/spi_synth/dut/TransmitWatermark_reg*
    dut/spi_synth/dut/ReceiveWatermark_reg*
    dut/spi_synth/dut/InterruptEnable_reg*
    dut/spi_synth/dut/TransmitReg_reg*
 }

set_retention_control pgd_retain_spi -domain pd_spi_gated \
 -save_signal    { spi_retention_save_enb high } \
 -restore_signal { spi_retention_restore_enb high }
suppress_message MV-159
map_retention_cell pgd_retain_spi -domain pd_spi_gated -lib_cells {SAEDLVT14_*}

set_retention pgd_retain_uart -domain pd_uart_gated \
 -retention_power_net VDDL_uart_gated \
 -retention_ground_net VSS \
 -elements {
    dut/uart_synth/dut/uartPC/FCR_reg*
    dut/uart_synth/dut/uartPC/LCR_reg*
    dut/uart_synth/dut/uartPC/SCR_reg*
    dut/uart_synth/dut/uartPC/DLL_reg*
    dut/uart_synth/dut/uartPC/DLM_reg*
    dut/uart_synth/dut/uartPC/IER_reg*
    dut/uart_synth/dut/uartPC/txsr_reg*
    dut/uart_synth/dut/uartPC/MCR_reg*
    dut/uart_synth/dut/uartPC/TXHR_reg*
 }

# Retention control: local virtual control (top-level will map it)
set_retention_control pgd_retain_uart -domain pd_uart_gated \
 -save_signal    { uart_retention_save_enb high } \
 -restore_signal { uart_retention_restore_enb high }

suppress_message MV-159

map_retention_cell pgd_retain_uart -domain pd_uart_gated -lib_cells {SAEDLVT14_*}


#connect_supply_net VDDL_spi_gated -port VDDL_spi_gated
#connect_supply_net VDDL_uart_gated -port VDDL_uart_gated
#connect_supply_net VDDM_eeprom_gated -port VDDM_eeprom_gated
connect_supply_net VDDL -port VDDL
connect_supply_net VDDM -port VDDM
connect_supply_net VDD -port VDD
connect_supply_net VSS -port VSS


set_level_shifter LtoH_sig_to_bridge -domain pd_ahbapb \
  -applies_to inputs -rule low_to_high -location  self

set_level_shifter HtoL_sig_from_bridge -domain pd_ahbapb \
  -applies_to outputs -rule high_to_low -location self

set_level_shifter LtoH_sig_to_eeprom -domain pd_eeprom_gated \
  -applies_to inputs -rule low_to_high -location  self

set_level_shifter HtoL_sig_from_eeprom -domain pd_eeprom_gated \
  -applies_to outputs -rule high_to_low -location self

set_level_shifter LtoH_sig_to_eeprom -domain pd_spi_gated \
  -applies_to outputs -rule low_to_high -location  self

set_level_shifter HtoL_sig_from_eeprom -domain pd_spi_gated \
  -applies_to inputs -rule high_to_low -location self

set_level_shifter LtoH_sig_to_eeprom -domain pd_uart_gated \
  -applies_to outputs -rule low_to_high -location  self

set_level_shifter HtoL_sig_from_eeprom -domain pd_uart_gated \
  -applies_to inputs -rule high_to_low -location self

set_level_shifter LtoH_sig_to_eeprom -domain pd_gpio \
  -applies_to outputs -rule low_to_high -location  self

set_level_shifter HtoL_sig_from_eeprom -domain pd_gpio \
  -applies_to inputs -rule high_to_low -location self

set_level_shifter LtoH_sig_to_eeprom -domain pd_clint \
  -applies_to outputs -rule low_to_high -location  self

set_level_shifter HtoL_sig_from_eeprom -domain pd_clint \
  -applies_to inputs -rule high_to_low -location self

set_level_shifter LtoH_sig_to_eeprom -domain pd_plic \
  -applies_to outputs -rule low_to_high -location  self

set_level_shifter HtoL_sig_from_eeprom -domain pd_plic \
  -applies_to inputs -rule high_to_low -location self

set_domain_supply_net pd_uncore  -primary_power_net VDD -primary_ground_net VSS

set_domain_supply_net pd_eeprom_gated  -primary_power_net VDDM_eeprom_gated -primary_ground_net VSS
set_domain_supply_net pd_spi_gated  -primary_power_net VDDL_spi_gated -primary_ground_net VSS
set_domain_supply_net pd_uart_gated  -primary_power_net VDDL_uart_gated -primary_ground_net VSS
set_domain_supply_net pd_gpio  -primary_power_net VDDL -primary_ground_net VSS
set_domain_supply_net pd_clint  -primary_power_net VDDL -primary_ground_net VSS
set_domain_supply_net pd_plic  -primary_power_net VDDL -primary_ground_net VSS
set_domain_supply_net pd_ahbapb  -primary_power_net VDDM -primary_ground_net VSS










