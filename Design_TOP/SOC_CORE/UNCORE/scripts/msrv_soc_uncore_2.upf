
create_power_domain pd_uncore
create_power_domain pd_clint  -elements {dut/clint_synth}
create_power_domain pd_spi_gated  -elements {dut/spi_synth}
create_power_domain pd_uart_gated  -elements {dut/uart_synth}
create_power_domain pd_gpio  -elements {dut/gpio_synth}
create_power_domain pd_ahbapb  -elements {dut/ahbapbbridge_synth}
create_power_domain pd_plic  -elements {dut/plic_synth}
create_power_domain pd_eeprom_gated -elements {dut/bootrom_synth/dut/memory}


create_supply_port VDD -domain pd_uncore
create_supply_port VDDL -domain pd_uncore
create_supply_port VSS -domain pd_uncore
create_supply_port VDDM -domain pd_uncore
create_supply_port VDDL_spi_gated -domain pd_spi_gated
create_supply_port VDDL_uart_gated -domain pd_uart_gated
create_supply_port VDDM_eeprom_gated -domain pd_eeprom_gated



create_supply_net VDD -domain pd_uncore
create_supply_net VDD -domain pd_uncore -reuse
create_supply_net VDDL -domain pd_uncore
create_supply_net VDDL -domain pd_uncore -reuse
create_supply_net VSS -domain pd_uncore
create_supply_net VSS -domain pd_uncore -reuse
create_supply_net VDDM -domain pd_uncore
create_supply_net VDDM -domain pd_uncore -reuse


create_supply_net VDD -domain pd_clint -reuse
create_supply_net VDDL -domain pd_clint -reuse
create_supply_net VSS -domain pd_clint -reuse

create_supply_net VDD -domain pd_plic -reuse
create_supply_net VDDL -domain pd_plic -reuse
create_supply_net VSS -domain pd_plic -reuse

create_supply_net VDD -domain pd_gpio -reuse
create_supply_net VDDL -domain pd_gpio -reuse
create_supply_net VSS -domain pd_gpio -reuse

create_supply_net VDD -domain pd_ahbapb -reuse
create_supply_net VSS -domain pd_ahbapb -reuse
create_supply_net VDDM -domain pd_ahbapb -reuse

create_supply_net VDD -domain pd_uart_gated -reuse
create_supply_net VDDL -domain pd_uart_gated -reuse
create_supply_net VSS -domain pd_uart_gated -reuse
create_supply_net VDDL_uart_gated -domain pd_uart_gated 
create_supply_net VDDL_uart_gated -domain pd_uart_gated -reuse


create_supply_net VDD -domain pd_spi_gated -reuse
create_supply_net VDDL -domain pd_spi_gated -reuse
create_supply_net VSS -domain pd_spi_gated -reuse
create_supply_net VDDL_spi_gated -domain pd_spi_gated 
create_supply_net VDDL_spi_gated -domain pd_spi_gated -reuse

create_supply_net VDD -domain pd_eeprom_gated -reuse
create_supply_net VDDM -domain pd_eeprom_gated -reuse
create_supply_net VSS -domain pd_eeprom_gated -reuse
create_supply_net VDDM_eeprom_gated -domain pd_eeprom_gated 
create_supply_net VDDM_eeprom_gated -domain pd_eeprom_gated -reuse


create_logic_port spi_powergate_enb -direction in
create_logic_port spi_isolation_enb -direction in
create_logic_port spi_retention_save_enb -direction in
create_logic_port spi_retention_restore_enb       -direction in
create_logic_port uart_powergate_enb  -direction in
create_logic_port uart_isolation_enb  -direction in
create_logic_port uart_retention_save_enb  -direction in
create_logic_port uart_retention_restore_enb         -direction in
create_logic_port eeprom_powergate_enb -direction in
create_logic_port eeprom_isolation_enb -direction in


create_power_switch sw_spi -domain pd_spi_gated -input_supply_port "sw_spi_VDDL VDDL" \
 -output_supply_port "sw_VDDL_spi_gated VDDL_spi_gated" \
 -control_port       "sw_spi_powergate_enb spi_powergate_enb" \
 -on_state           "SW_PGD_SPI_ON sw_spi_VDDL {!sw_spi_powergate_enb}"

create_power_switch sw_uart -domain pd_uart_gated -input_supply_port "sw_uart_VDDL VDDL" \
 -output_supply_port "sw_VDDL_uart_gated VDDL_uart_gated" \
 -control_port       "sw_uart_powergate_enb uart_powergate_enb" \
 -on_state           "SW_PGD_UART_ON sw_uart_VDDL {!sw_uart_powergate_enb}"

create_power_switch sw_eeprom -domain pd_eeprom_gated -input_supply_port "sw_eeprom_VDDM VDDM" \
 -output_supply_port "sw_VDDM_eeprom_gated VDDM_eeprom_gated" \
 -control_port       "sw_eeprom_powergate_enb eeprom_powergate_enb" \
 -on_state           "SW_PGD_EEPROM_ON sw_eeprom_VDDM {!sw_eeprom_powergate_enb}"


