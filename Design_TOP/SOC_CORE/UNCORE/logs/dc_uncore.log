# -----------------------------------------------------
# 5) (Optional) Level shifters
# If bridge interfaces with other domains, define LS here.
# For example, if signals cross from bridge <-> pd_core or pd_io_interface.
# -----------------------------------------------------
set_level_shifter LtoH_sig_to_bridge -domain pd_bridge \
    -applies_to inputs -rule low_to_high -location self
#
set_level_shifter HtoL_sig_from_bridge -domain pd_bridge \
    -applies_to outputs -rule high_to_low -location self

